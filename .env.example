# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (exposed to the browser) ---------------------------------------
# Firebase web app config: Firebase console > Project settings > Your apps.
# These identify the project; access is controlled by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to talk to the local Auth + Firestore emulators (npm run emulators).
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Public URL of this site. Used for metadata and as the base of the Paystack
# callback URL (${NEXT_PUBLIC_SITE_URL}/checkout/callback), so it must match the
# address you open the store on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link to the developer's portfolio, shown in the footer.
NEXT_PUBLIC_PORTFOLIO_URL=https://example.com

# Paystack TEST public key (starts with pk_test_). Public by design; the
# checkout uses Paystack's hosted page, so it's only shown for reference.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Server-only ------------------------------------------------------------
# SERVER-ONLY. Paystack TEST secret key (starts with sk_test_). The app refuses
# any other key. Never expose it to the browser, never prefix it with
# NEXT_PUBLIC_, never log or commit it.
PAYSTACK_SECRET_KEY=
