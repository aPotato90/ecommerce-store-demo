# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (exposed to the browser) ---------------------------------------
# Firebase web app config: Firebase console > Project settings > Your apps.
# These identify the project; access is controlled by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to talk to the local Auth + Firestore emulators (npm run emulators).
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# Canonical URL of this site (used for metadata and, later, Stripe redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link to the developer's portfolio, shown in the footer.
NEXT_PUBLIC_PORTFOLIO_URL=https://example.com

# --- Server-only ------------------------------------------------------------
# SERVER-ONLY. Stripe TEST mode secret key (starts with sk_test_). Never expose
# it to the browser, never prefix it with NEXT_PUBLIC_, never log or commit it.
STRIPE_SECRET_KEY=
